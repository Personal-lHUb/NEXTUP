# ─── Database ───────────────────────────────────────────────
# Local Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://nextup:nextup@localhost:5432/nextup?schema=public"

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Auth / Session ─────────────────────────────────────────
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-me"
# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE="604800"

# When true, dashboards render from in-memory seed data so the UI is
# navigable without a running database. Set to "false" once Postgres is up.
USE_MOCK_DATA="true"

# ─── Payments / Escrow (Stripe Connect) ─────────────────────
# Leave blank to use the mock escrow provider. Provide real keys to switch
# to the Stripe Connect implementation (lib/services/escrow.ts).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Platform take rate in basis points (1300 = 13%).
PLATFORM_TAKE_RATE_BPS="1300"

# ─── Shipping ───────────────────────────────────────────────
# Carrier aggregator API (e.g. EasyPost/Shippo). Blank = mock labels.
SHIPPING_API_KEY=""

# Micro-margin added on top of carrier shipping cost, in basis points.
SHIPPING_MARGIN_BPS="500"

# ─── Protected file storage ─────────────────────────────────
# Object storage for blinded STL/OBJ source files (never exposed to makers).
# STORAGE_DRIVER: "local" (filesystem, dev) or "s3" (S3 / R2 / MinIO).
STORAGE_DRIVER="local"
# Local driver root (used when STORAGE_DRIVER=local).
FILE_STORAGE_LOCAL_DIR=".storage"
# S3-compatible settings (used when STORAGE_DRIVER=s3).
FILE_STORAGE_BUCKET="nextup-protected-files"
FILE_STORAGE_REGION="auto"
FILE_STORAGE_ENDPOINT=""          # e.g. http://localhost:9000 for MinIO
FILE_STORAGE_ACCESS_KEY=""
FILE_STORAGE_SECRET_KEY=""
FILE_STORAGE_FORCE_PATH_STYLE="true"  # required by MinIO

# ─── Slicing / Streaming ────────────────────────────────────
# Path to a slicer CLI (PrusaSlicer/Slic3r/CuraEngine). Blank = mock slicer.
SLICER_BIN=""
# Optional slicer config/profile passed to the CLI.
SLICER_PROFILE=""
# Lifetime of a single-use G-code stream token, in seconds (default 15 min).
GCODE_TOKEN_TTL="900"

# ─── QC ─────────────────────────────────────────────────────
# Silent-consent window: client auto-approves QC photos after N hours.
QC_AUTO_APPROVE_HOURS="48"
