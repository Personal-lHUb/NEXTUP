# Copia in `.env` e carica con: set -a; source .env; set +a
# In alternativa autenticati con: ant auth login
ANTHROPIC_API_KEY=sk-ant-...

# Cartella dei progetti libro (default: ./books)
# KDPFACTORY_BOOKS_DIR=/percorso/ai/libri

# Cartella con font .ttf personalizzati (hanno priorità su quelli di sistema)
# KDPFACTORY_FONTS_DIR=/percorso/ai/font
